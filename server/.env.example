# Class Clinic — Appointment Scheduler (server)
#
# Environment variables (copy to .env and edit):
#   DATABASE_URL=postgresql://USER:PASSWORD@HOST:PORT/DBNAME?schema=public
#   SESSION_SECRET=change-me-to-a-long-random-string
#   PORT=4000

# Example (local postgres user `clinic`, db `clinic_db`, trust auth):
#   DATABASE_URL=postgresql://clinic:clinic@localhost:5432/clinic_db
#   SESSION_SECRET=8f3a... (generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
